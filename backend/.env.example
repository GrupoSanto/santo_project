# ── Seguridad ──────────────────────────────────────────────────────
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,GrupoSanto.pythonanywhere.com
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://GrupoSanto.pythonanywhere.com

# ── JWT ────────────────────────────────────────────────────────────
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# ── Base de datos ──────────────────────────────────────────────────
# Opciones: postgresql | mysql | (vacío = SQLite solo en desarrollo)
DB_ENGINE=postgresql
DB_NAME=proyectos_santo
DB_USER=santo_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ── Contraseñas iniciales (seed_users) ────────────────────────────
# Si no se definen, el comando genera contraseñas aleatorias e imprime una vez.
SEED_PASS_MATHIAS=
SEED_PASS_MARIAJOSE=
SEED_PASS_HECTOR=
SEED_PASS_FRANCISCO=
SEED_PASS_JOHNN=
